# Copy to .env and adjust. Never commit .env.

# Database (async URL for the app; Alembic derives a sync URL from it)
DATABASE_URL=postgresql+asyncpg://patchpulse:patchpulse@localhost:5432/patchpulse
REDIS_URL=redis://localhost:6379/0

# Embeddings (Step 6)
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768

# LLM (Step 5+). Format: <provider>:<model>, e.g. groq:<model>, openrouter:<model>, ollama:<model>
LLM_MODEL=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLASSIFY_BATCH_SIZE=20

# Langfuse tracing (Step 8)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
